# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Parlamenta API (server/) ---
# Platform super admin created on first start. If SUPERADMIN_PASSWORD is empty,
# a random password is generated and printed once in the API console.
SUPERADMIN_EMAIL="admin@parlamenta.local"
SUPERADMIN_PASSWORD=""
API_PORT=3001
SESSION_TTL_HOURS=8

# --- Banco de Dados > Discursos ---
# Gemini model used for transcription ("decupagem"), PDF OCR and theme tagging.
# GEMINI_API_KEY (above) must be set for audio/video/PDF; text and .docx work without it.
GEMINI_MODEL="gemini-2.5-flash"
# Max upload size per speech file, in MB.
MAX_SPEECH_UPLOAD_MB=1024

# --- E-mail (Resend) — alertas ao cidadão sobre protocolos ---
# Chave em https://resend.com/api-keys. Sem ela os e-mails ficam na fila e são enviados quando configurada.
RESEND_API_KEY=""
# Remetente em um domínio verificado no Resend. O nome exibido é o do gabinete,
# ou use o formato completo: "Gabinete Dep. Fulano <protocolos@seudominio.gov.br>".
RESEND_FROM_EMAIL="protocolos@seudominio.gov.br"
# APP_URL (acima) é usado nos links "Acompanhar protocolo" dos e-mails, ex.: https://app.parlamenta.com.br
