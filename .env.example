# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Parlamentta API (server/) ---
# PostgreSQL. No Railway use a referência ${{Postgres.DATABASE_URL}} (rede privada).
# Em desenvolvimento: `npm run dev:db` (Postgres local via PGlite) e PG_POOL_MAX=1.
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5433/postgres"
PG_POOL_MAX=10
# Arquivos enviados (discursos) ficam em disco: no Railway monte um Volume e aponte para ele.
PARLAMENTTA_DATA_DIR="./data"
# Platform super admin created on first start. If SUPERADMIN_PASSWORD is empty,
# a random password is generated and printed once in the API console.
SUPERADMIN_EMAIL="admin@parlamentta.local"
SUPERADMIN_PASSWORD=""
API_PORT=3001
SESSION_TTL_HOURS=8

# --- Banco de Dados > Discursos ---
# Gemini model used for transcription ("decupagem"), PDF OCR and theme tagging.
# GEMINI_API_KEY (above) must be set for audio/video/PDF; text and .docx work without it.
GEMINI_MODEL="gemini-2.5-flash"
# Max upload size per speech file, in MB.
MAX_SPEECH_UPLOAD_MB=1024

# --- E-mail (Resend) — alertas ao cidadão sobre protocolos ---
# Chave em https://resend.com/api-keys. Sem ela os e-mails ficam na fila e são enviados quando configurada.
RESEND_API_KEY=""
# Remetente em um domínio verificado no Resend. O nome exibido é o do gabinete,
# ou use o formato completo: "Gabinete Dep. Fulano <protocolos@seudominio.gov.br>".
RESEND_FROM_EMAIL="protocolos@seudominio.gov.br"
# APP_URL (acima) é usado nos links "Acompanhar protocolo" dos e-mails, ex.: https://app.parlamentta.com.br

# --- WhatsApp (wacli — https://wacli.sh) ---
# O binário é baixado para ./bin/wacli no build (`npm run wacli:install`). Defina WACLI_BIN para usar outro.
# A sessão de cada gabinete fica em PARLAMENTTA_DATA_DIR/whatsapp — no Railway esse diretório PRECISA
# estar num Volume, senão o número é desconectado a cada deploy.
WACLI_BIN=""
